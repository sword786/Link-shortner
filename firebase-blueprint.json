{
  "entities": {
    "Link": {
      "title": "Link",
      "description": "A shortened URL record",
      "type": "object",
      "properties": {
        "originalUrl": { "type": "string" },
        "shortCode": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["originalUrl", "shortCode", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "links/{shortCode}": {
      "schema": { "$ref": "#/entities/Link" },
      "description": "Stored links"
    }
  }
}
